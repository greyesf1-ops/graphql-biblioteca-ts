{
  "name": "graphql-biblioteca-ts",
  "version": "1.0.0",
  "description": "Servicio GraphQL tipado para gestionar un catalogo de biblioteca.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-schema.mjs",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --reporter=verbose",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "graphql",
    "typescript",
    "graphql-yoga",
    "dataloader"
  ],
  "license": "MIT",
  "dependencies": {
    "dataloader": "^2.2.3",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.22.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}

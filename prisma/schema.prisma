generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum BookStatus {
  AVAILABLE
  LOANED
  RESERVED
  MAINTENANCE
}

model Author {
  id        String   @id
  name      String
  country   String
  biography String?
  books     Book[]
}

model Book {
  id              String     @id
  title           String
  summary         String?
  isbn            String     @unique
  status          BookStatus @default(AVAILABLE)
  publishedYear   Int?
  authorId        String
  shelfCode       String     @default("PENDING")
  acquisitionCost Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  author          Author     @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  loans           Loan[]

  @@index([authorId])
}

/// Un prestamo referencia un libro. La migracion agrega, ademas de la clave
/// foranea, un indice unico parcial (solo sobre prestamos sin devolucion) para
/// que la base de datos nunca permita dos prestamos activos del mismo libro.
/// Prisma no expresa el "WHERE" del indice parcial en este DSL, por lo que la
/// restriccion real vive en migration.sql; ver prisma/migrations/20260912_add_loan_entity.
model Loan {
  id           String    @id
  bookId       String
  borrowerName String
  loanedAt     DateTime  @default(now())
  returnedAt   DateTime?
  book         Book      @relation(fields: [bookId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([bookId])
}
